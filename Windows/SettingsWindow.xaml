<Window x:Class="LunaCopy.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LunaCopy.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Tr Settings.WindowTitle}"
        Width="576"
        Height="616"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#202020"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/LunaCopy;component/Assets/app.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="0" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Fluent ToggleSwitch Style (CheckBox) -->
        <Style x:Key="FluentToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="StateLabel"
                                       Text="{loc:Tr Toggle.Off}"
                                       Foreground="#C8C8C8"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Grid Width="40" Height="20" Background="Transparent">
                                <Border x:Name="SwitchTrack"
                                        CornerRadius="10"
                                        Background="#1D1D1D"
                                        BorderBrush="#9A9A9A"
                                        BorderThickness="1"/>
                                <Ellipse x:Name="SwitchThumb"
                                         Width="12"
                                         Height="12"
                                         Fill="#CECECE"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StateLabel" Property="Text" Value="{loc:Tr Toggle.On}"/>
                                <Setter TargetName="StateLabel" Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#60CDFF"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#60CDFF"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#000000"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="24,0,0,0"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="SwitchThumb" Property="Width" Value="14"/>
                                <Setter TargetName="SwitchThumb" Property="Height" Value="14"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="3,0,0,0"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#4CC2FF"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#4CC2FF"/>
                                <Setter TargetName="SwitchThumb" Property="Width" Value="14"/>
                                <Setter TargetName="SwitchThumb" Property="Height" Value="14"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="23,0,0,0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Accent Button Style -->
        <Style x:Key="FluentAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#60CDFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#78D6FF"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#4CC2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#38B3F0"/>
                                <Setter Property="Foreground" Value="#141414"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#323232"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="#787878"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Standard Subtle Button Style -->
        <Style x:Key="FluentStandardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#323232"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3B3B3B"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#292929"/>
                                <Setter Property="Foreground" Value="#C8C8C8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#272727"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#303030"/>
                                <Setter Property="Foreground" Value="#6E6E6E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Caption Buttons -->
        <Style x:Key="FluentCaptionMinimizeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D6D6D6"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E2E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentCaptionCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D6D6D6"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B12719"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Mica Dark Surface (#202020) -->
    <Border Background="#202020"
            BorderBrush="#333333"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Fluent Custom AppTitleBar -->
            <Grid Grid.Row="0"
                  Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image x:Name="HeaderIconImage"
                           Width="16"
                           Height="16"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="LunaCopy"
                               Foreground="#FFFFFF"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="LanguageButton"
                            FontFamily="Segoe UI Variable Text, Segoe UI"
                            FontSize="11"
                            FontWeight="SemiBold"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource FluentCaptionMinimizeButtonStyle}"
                            Click="LanguageButton_Click"/>
                    <Button Content="&#xE921;"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Style="{StaticResource FluentCaptionMinimizeButtonStyle}"
                            Click="MinimizeButton_Click"/>
                    <Button Content="✕"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            FontSize="12"
                            Style="{StaticResource FluentCaptionCloseButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Fluent Page Header -->
            <Grid Grid.Row="1" Margin="28,10,28,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr Settings.Heading}"
                               Foreground="#FFFFFF"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="26"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Tr Settings.Subtitle}" TextWrapping="Wrap"
                               Foreground="#9D9D9D"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12.5"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Version Pill Badge -->
                <Border Grid.Column="1"
                        Background="#2B2B2B"
                        BorderBrush="#3A3A3A"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Text="v1.2.0"
                               Foreground="#60CDFF"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="11.5"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- Section: Основные параметры (3 Settings Expander Cards) -->
            <StackPanel Grid.Row="2" Margin="28,0,28,18">
                <TextBlock Text="{loc:Tr Settings.General}"
                           Foreground="#FFFFFF"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <!-- Card 1: Запуск вместе с Windows -->
                <Border Background="#2B2B2B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,13"
                        Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE7E8;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="17"
                                   Foreground="#E0E0E0"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Tr Settings.Startup.Title}"
                                       Foreground="#FFFFFF"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13.5"/>
                            <TextBlock Text="{loc:Tr Settings.Startup.Desc}" TextWrapping="Wrap"
                                       Foreground="#9D9D9D"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <CheckBox x:Name="StartupToggle"
                                  Grid.Column="2"
                                  Style="{StaticResource FluentToggleSwitchStyle}"
                                  Click="StartupToggle_Click"/>
                    </Grid>
                </Border>

                <!-- Card 2: Звуковой сигнал -->
                <Border Background="#2B2B2B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,13"
                        Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE767;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="17"
                                   Foreground="#E0E0E0"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Tr Settings.Sound.Title}"
                                       Foreground="#FFFFFF"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13.5"/>
                            <TextBlock Text="{loc:Tr Settings.Sound.Desc}" TextWrapping="Wrap"
                                       Foreground="#9D9D9D"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <CheckBox x:Name="SoundToggle"
                                  Grid.Column="2"
                                  Style="{StaticResource FluentToggleSwitchStyle}"
                                  Click="SoundToggle_Click"/>
                    </Grid>
                </Border>

                <!-- Card 3: Всплывающая подсказка -->
                <Border Background="#2B2B2B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE8BD;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="17"
                                   Foreground="#E0E0E0"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Tr Settings.Toast.Title}"
                                       Foreground="#FFFFFF"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13.5"/>
                            <TextBlock Text="{loc:Tr Settings.Toast.Desc}" TextWrapping="Wrap"
                                       Foreground="#9D9D9D"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <CheckBox x:Name="ToastToggle"
                                  Grid.Column="2"
                                  Style="{StaticResource FluentToggleSwitchStyle}"
                                  Click="ToastToggle_Click"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Section: Исключенные приложения -->
            <Grid Grid.Row="3" Margin="28,0,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{loc:Tr Settings.Exclusions}"
                           Foreground="#FFFFFF"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Border Grid.Row="1"
                        Background="#2B2B2B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header + Buttons -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="&#xE8F8;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="17"
                                       Foreground="#E0E0E0"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Tr Settings.Excluded.Title}"
                                           Foreground="#FFFFFF"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="13.5"/>
                                <TextBlock Text="{loc:Tr Settings.Excluded.Desc}" TextWrapping="Wrap"
                                           Foreground="#9D9D9D"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="12"
                                           Margin="0,1,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{loc:Tr Settings.Add}"
                                        Style="{StaticResource FluentAccentButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="AddExclusionButton_Click"/>
                                <Button x:Name="RemoveExclusionButton"
                                        Content="{loc:Tr Settings.Remove}"
                                        Style="{StaticResource FluentStandardButtonStyle}"
                                        IsEnabled="False"
                                        Click="RemoveExclusionButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fluent ListView Style ListBox -->
                        <Border Grid.Row="1"
                                Background="#202020"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4">
                            <ListBox x:Name="ExcludedListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFFFFF"
                                     SelectionChanged="ExcludedListBox_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="Margin" Value="2,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Foreground" Value="#E6E6E6"/>
                                        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBd"
                                                            Background="Transparent"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <Grid>
                                                            <Border x:Name="AccentPill"
                                                                    Width="3"
                                                                    Height="16"
                                                                    CornerRadius="1.5"
                                                                    Background="#60CDFF"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Margin="-8,0,0,0"
                                                                    Visibility="Collapsed"/>
                                                            <ContentPresenter VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBd" Property="Background" Value="#2D2D2D"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBd" Property="Background" Value="#333333"/>
                                                            <Setter TargetName="AccentPill" Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
