<Window x:Class="LunaCopy.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="False">
    <Border Background="#202026"
            BorderBrush="#383842"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,5"
            Margin="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <TextBlock Text="Скопировано!"
                   Foreground="#FFFFFF"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="12.5"
                   FontWeight="Medium"/>
    </Border>
</Window>
