<Window x:Class="LunaCopy.Windows.AddExclusionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить исключение"
        Width="450"
        Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="WinUiAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#60CDFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#78D6FF"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#4CC2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#38B3F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinUiStandardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#323232"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3B3B3B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#292929"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D6D6D6"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- WinUI 3 ContentDialog Style Container -->
    <Border Background="#2B2B2B"
            BorderBrush="#3D3D3D"
            BorderThickness="1"
            CornerRadius="8"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.65" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Dialog Content Area -->
            <Grid Grid.Row="0" Margin="22,18,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                      Margin="0,0,0,14">
                    <TextBlock Text="Добавить исключение"
                               Foreground="#FFFFFF"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Style="{StaticResource CloseIconButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"/>
                </Grid>

                <!-- Input Section with WinUI 3 Bottom Focus Accent Line -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock Text="Имя процесса (например: notepad)"
                               Foreground="#C8C8C8"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12.5"
                               Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#202020"
                                BorderBrush="#60CDFF"
                                BorderThickness="1,1,1,2"
                                CornerRadius="4"
                                Padding="10,0">
                            <TextBox x:Name="ProcessNameTextBox"
                                     Background="Transparent"
                                     Foreground="#FFFFFF"
                                     CaretBrush="#60CDFF"
                                     BorderThickness="0"
                                     FontFamily="Segoe UI Variable Text, Segoe UI"
                                     FontSize="13.5"
                                     VerticalContentAlignment="Center"
                                     Height="34"
                                     KeyDown="ProcessNameTextBox_KeyDown"/>
                        </Border>

                        <Button Grid.Column="2"
                                Content="ОБЗОР"
                                Style="{StaticResource WinUiStandardButtonStyle}"
                                Click="BrowseButton_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Running Apps Label -->
                <TextBlock Grid.Row="2"
                           Text="Или выберите из запущенных приложений:"
                           Foreground="#C8C8C8"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12.5"
                           Margin="0,0,0,6"/>

                <!-- Running Apps List -->
                <Border Grid.Row="3"
                        Background="#202020"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="4">
                    <ListBox x:Name="RunningProcessesListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#FFFFFF"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="RunningProcessesListBox_SelectionChanged"
                             MouseDoubleClick="RunningProcessesListBox_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,7"/>
                                <Setter Property="Margin" Value="2,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="#E6E6E6"/>
                                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBd"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Border x:Name="AccentPill"
                                                            Width="3"
                                                            Height="14"
                                                            CornerRadius="1.5"
                                                            Background="#60CDFF"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Margin="-8,0,0,0"
                                                            Visibility="Collapsed"/>
                                                    <ContentPresenter VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBd" Property="Background" Value="#2D2D2D"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBd" Property="Background" Value="#333333"/>
                                                    <Setter TargetName="AccentPill" Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Grid>

            <!-- WinUI 3 ContentDialog Footer Bar -->
            <Border Grid.Row="1"
                    Background="#202020"
                    BorderBrush="#333333"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="22,14">
                <Button Content="ДОБАВИТЬ"
                        Style="{StaticResource WinUiAccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="AddButton_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
